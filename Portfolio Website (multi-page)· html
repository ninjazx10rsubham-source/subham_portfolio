// =========================
// FILE: style.css
// =========================
body {
  font-family: Arial;
  margin: 0;
  background: linear-gradient(45deg, #ff6ec4, #7873f5);
  color: white;
}

nav {
  display: flex;
  justify-content: space-between;
  padding: 15px;
  background: rgba(0,0,0,0.5);
}

nav ul {
  display: flex;
  list-style: none;
}

nav ul li a {
  margin: 10px;
  text-decoration: none;
  color: white;
  transition: 0.3s;
}

nav ul li a:hover {
  color: yellow;
  transform: scale(1.2);
}

.hero {
  text-align: center;
  margin-top: 50px;
}

.hero img {
  width: 150px;
  border-radius: 50%;
  transition: 0.3s;
}

.hero img:hover {
  transform: scale(1.1);
}

button {
  padding: 10px;
  background: black;
  color: white;
  border: none;
  cursor: pointer;
}

button:hover {
  background: yellow;
  color: black;
}

// =========================
// FILE: script.js
// =========================
function editName() {
  let name = prompt("Enter your name:");
  document.getElementById("name").innerText = name;
}

function saveBio() {
  localStorage.setItem("bio", document.getElementById("bio").value);
}

window.onload = function() {
  if(document.getElementById("bio")) {
    document.getElementById("bio").value = localStorage.getItem("bio") || "";
  }
}

function addProject() {
  let input = document.getElementById("projectInput");
  let list = document.getElementById("projectList");

  let li = document.createElement("li");
  li.innerText = input.value;
  li.onclick = () => li.remove();

  list.appendChild(li);
}

function addAchievement() {
  let input = document.getElementById("achInput");
  let list = document.getElementById("achList");

  let li = document.createElement("li");
  li.innerText = input.value;
  li.onclick = () => li.remove();

  list.appendChild(li);
}

function saveContact() {
  localStorage.setItem("email", document.getElementById("email").value);
  localStorage.setItem("phone", document.getElementById("phone").value);
  localStorage.setItem("linkedin", document.getElementById("linkedin").value);
}
